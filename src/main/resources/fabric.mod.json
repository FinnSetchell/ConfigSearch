{
	"schemaVersion": 1,
	"id": "configsearch",
	"version": "${version}",
	"name": "Config Search",
	"description": "Search every mod's config options from one search bar in Mod Menu.",
	"authors": [
		"FinnDog"
	],
	"contact": {
		"ko-fi": "https://ko-fi.com/finndog"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/configsearch/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.finndog.configsearch.ConfigSearchClient"
		],
		"modmenu": [
			"dev.finndog.configsearch.compat.ModMenuEntry"
		]
	},
	"mixins": [
		"configsearch.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "${minecraftDep}",
		"java": ">=${javaVersion}",
		"fabric-api": "*",
		"modmenu": "*"
	}
}
